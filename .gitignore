# abgeleitetes dunkles Logo (wird bei Bedarf aus logo-horizontal.png erzeugt)
brand-guidelines/*/assets/logo-horizontal-dark.png
# catalog.json + README.md im gf-fotos/-Ordner BLEIBEN getrackt — nur Bilddateien raus:
brand-guidelines/*/gf-fotos/*.jpg
brand-guidelines/*/gf-fotos/*.jpeg
brand-guidelines/*/gf-fotos/*.png
brand-guidelines/*/gf-fotos/*.webp
brand-guidelines/*/gf-fotos/*.heic
# Künftige KI-Bilder der GF (eigener Ordner) ebenfalls ignorieren:
brand-guidelines/*/gf-ki/*.jpg
brand-guidelines/*/gf-ki/*.jpeg
brand-guidelines/*/gf-ki/*.png
brand-guidelines/*/gf-ki/*.webp

